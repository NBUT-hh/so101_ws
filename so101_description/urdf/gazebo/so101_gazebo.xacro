<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="so101_gazebo">
    <gazebo>
      <plugin
        filename="gz_ros2_control-system"
        name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find so101_bringup)/config/ros2_control/follower_split_controllers.yaml</parameters>
        <ros>
          <namespace>follower</namespace>
        </ros>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
